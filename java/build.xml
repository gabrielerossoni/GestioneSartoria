<?xml version="1.0" encoding="UTF-8"?>
<project name="GestioneSartoria_Java" default="default" basedir=".">
    <description>Builds, tests, and runs the project GestioneSartoria_Java.</description>

    <!-- Proprietà generali del progetto -->
    <property name="src.dir" location="src"/>
    <property name="build.dir" location="build"/>
    <property name="build.classes.dir" location="${build.dir}/classes"/>
    <property name="dist.dir" location="dist"/>
    <property name="dist.jar" location="${dist.dir}/GestioneSartoria.jar"/>
    <property name="main.class" value="gestionesartoria.gui.FinestraPrincipale"/>

    <!-- TARGET DEFAULT -->
    <target name="default" depends="jar" description="Build standard"/>

    <!-- TARGET INIT -->
    <target name="init">
        <mkdir dir="${build.classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <!-- TARGET COMPILE -->
    <target name="compile" depends="init" description="Compila i sorgenti Java">
        <javac srcdir="${src.dir}" destdir="${build.classes.dir}" includeantruntime="false" encoding="UTF-8" source="21" target="21">
            <compilerarg value="-Xlint:unchecked"/>
            <compilerarg value="-Xlint:deprecation"/>
        </javac>
        <!-- Copia i file di risorse (es. file .form di NetBeans e icone) nel build directory -->
        <copy todir="${build.classes.dir}">
            <fileset dir="${src.dir}" excludes="**/*.java"/>
        </copy>
    </target>

    <!-- TARGET JAR -->
    <target name="jar" depends="compile" description="Crea il file JAR eseguibile distribuibile">
        <jar destfile="${dist.jar}" basedir="${build.classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
                <attribute name="Built-By" value="${user.name}"/>
                <attribute name="Class-Path" value="."/>
            </manifest>
        </jar>
        <echo message="JAR generato con successo in: ${dist.jar}"/>
    </target>

    <!-- TARGET RUN -->
    <target name="run" depends="jar" description="Esegue l'applicazione con GUI">
        <java jar="${dist.jar}" fork="true"/>
    </target>

    <!-- TARGET CLEAN -->
    <target name="clean" description="Pulisce i file compilati e il JAR">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

</project>
